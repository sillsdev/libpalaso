<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>$(TargetFrameworks);net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <SignAssembly>false</SignAssembly>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <StartupObject>ArchivingTestApp.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- net8.0-windows isn't one of SIL.Core/SIL.WritingSystems's own TFMs, so a
         net8.0-windows consumer's ProjectReference falls back to their netstandard2.0
         build, which now requires the newer Markdig.Signed (see SIL.Core.csproj). Match
         that here so restore doesn't see a downgrade. -->
    <PackageReference Include="Markdig.Signed" Version="0.37.0" Condition="'$(TargetFramework)' != 'net8.0-windows'" />
    <PackageReference Include="Markdig.Signed" Version="0.41.1" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SIL.Archiving\SIL.Archiving.csproj" />
    <ProjectReference Include="..\..\SIL.Core\SIL.Core.csproj" />
    <ProjectReference Include="..\..\SIL.Windows.Forms.Archiving\SIL.Windows.Forms.Archiving.csproj" />
  </ItemGroup>

</Project>