<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworks);netstandard2.0</TargetFrameworks>
    <RootNamespace>SIL.DblBundle</RootNamespace>
    <AssemblyTitle>SIL.DblBundle</AssemblyTitle>
    <Description>SIL.DblBundle provides classes for building a Digital Bible Library (DBL) bundle.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="5.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <!-- SIL.ReleaseTasks 3.3.0 pulls in Microsoft.Build.Tasks.Core, which has no net462/net48
         asset and is consumed via its netstandard2.0 fallback there, which disrupts implicit
         WindowsBase/System.IO.Packaging resolution for those TFMs (see SIL.Archiving.Tests).
         netstandard2.0 itself is unaffected, so only it gets the newer version. Revisit once
         SIL.ReleaseTasks/Microsoft.Build.Tasks.Core ship a net462-compatible asset, or once
         the net462/net48 WindowsBase interaction has been tested and ruled safe. -->
    <PackageReference Include="SIL.ReleaseTasks" Version="3.1.1" PrivateAssets="All" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
    <PackageReference Include="SIL.ReleaseTasks" Version="3.3.0" PrivateAssets="All" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SIL.Core\SIL.Core.csproj" />
    <ProjectReference Include="..\SIL.Scripture\SIL.Scripture.csproj" />
    <ProjectReference Include="..\SIL.WritingSystems\SIL.WritingSystems.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\text_2_0_to_1_5.xsl" />
    <None Include="Resources\text_2_1_to_1_5.xsl" />
  </ItemGroup>

</Project>
