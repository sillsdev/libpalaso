root = true

# Defaults
[*]
indent_style = tab
indent_size = tab
tab_width = 4
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = false
max_line_length = 98

[*.cs]
indent_style = tab
tab_width = 4
# Culture-sensitive string searches (IndexOf, StartsWith, EndsWith, Compare, ...) give wrong
# answers in some cultures; e.g. Thai collation ignores punctuation, so "abc".IndexOf("/") is 0
# under th-TH (BL-16932, BL-16947). Always pass a StringComparison.
dotnet_diagnostic.CA1310.severity = error

# Disable trimming for designer-generated files to avoid churn
[*.{Designer.cs,resx}]
trim_trailing_whitespace = false

# Settings Visual Studio uses for generated files
[*.{csproj,resx,settings,targets,vcxproj*,vdproj,xml,yml,props,md}]
indent_style = space
indent_size = 2

# Generated file
[*.sln]
end_of_line = crlf
